{
  "name": "hack-810705c9-bgk-team",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "doctor": "./doctor.sh",
    "start:dev": "./start.sh",
    "test:security": "node --test tests/dependency-security.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.2",
  "overrides": {
    "ansi-to-react>linkify-it": "5.0.2",
    "@esbuild-kit/core-utils>esbuild": "0.25.12"
  },
  "patchedDependencies": {
    "@ai-sdk/provider-utils@2.2.8": "patches/@ai-sdk%2Fprovider-utils@2.2.8.patch"
  }
}
